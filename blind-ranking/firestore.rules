rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{code} {
      allow read: if request.auth != null;
      // Only the creator can make the game, and only the creator can ever change it.
      allow create: if request.auth != null && request.resource.data.hostId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.hostId == request.auth.uid;

      match /players/{pid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == pid;
      }
    }
  }
}
